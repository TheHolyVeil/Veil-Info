// Veil info — page scroller UI (docs / design notes for the Veil project)
// TWM / OneShot palette

import { ScrollView } from "std-widgets.slint";

export global Palette {
    out property <color> bg-top: #1a0f2e;
    out property <color> bg-bottom: #08040f;
    out property <color> accent: #8a6bc4;
    out property <color> fg: #efe6ff;
    out property <color> fg-dim: #b8a8d9;
}

export struct DocEntry {
    title: string,
    body: string,
}

component PageDot {
    in property <bool> active;
    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: active ? Palette.accent : Palette.fg-dim.with-alpha(0.3);
        animate background { duration: 150ms; }
    }
}

component DocPage inherits Rectangle {
    in property <string> title;
    in property <string> body;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        Text {
            text: title;
            color: Palette.accent;
            font-size: 20px;
            font-weight: 700;
        }

        ScrollView {
            viewport-width: self.width;
            viewport-height: body-text.preferred-height;

            body-text := Text {
                text: body;
                color: Palette.fg;
                font-size: 14px;
                wrap: word-wrap;
                width: parent.width - 16px;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Veil";
    width: 560px;
    height: 420px;
    background: @linear-gradient(180deg, Palette.bg-top 0%, Palette.bg-bottom 100%);

    // Content lives in Rust (main.rs) — recompile to edit. See DocEntry.
    in property <[DocEntry]> pages: [];

    property <int> page-count: pages.length;
    property <int> current-index: 0;

    callback next-page();
    callback prev-page();

    next-page() => {
        current-index = min(current-index + 1, page-count - 1);
    }
    prev-page() => {
        current-index = max(current-index - 1, 0);
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.RightArrow) {
                root.next-page();
                accept
            } else if (event.text == Key.LeftArrow) {
                root.prev-page();
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            Rectangle {
                clip: true;
                height: parent.height - 60px;

                // Horizontal track holding both pages side by side.
                Rectangle {
                    x: -current-index * root.width;
                    width: root.page-count * root.width;
                    height: parent.height;
                    animate x { duration: 220ms; easing: ease-in-out; }

                    HorizontalLayout {
                        for page[i] in root.pages: DocPage {
                            width: root.width;
                            title: page.title;
                            body: page.body;
                        }
                    }
                }
            }

            // Nav bar: Back / dots / Next
            HorizontalLayout {
                height: 60px;
                padding: 16px;
                alignment: space-between;

                Rectangle {
                    width: 70px;
                    TouchArea {
                        clicked => { root.prev-page(); }
                    }
                    Text {
                        text: "< Back";
                        color: current-index == 0 ? Palette.fg-dim.with-alpha(0.4) : Palette.fg;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    for i in root.page-count: PageDot {
                        active: i == current-index;
                    }
                }

                Rectangle {
                    width: 70px;
                    TouchArea {
                        clicked => { root.next-page(); }
                    }
                    Text {
                        text: "Next >";
                        color: current-index == page-count - 1 ? Palette.fg-dim.with-alpha(0.4) : Palette.fg;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }
}
